# ============================================
# LLRWD-RMS 環境變數設定
# 複製本檔案為 .env 並填入實際值
# ============================================

# ---------- 資料庫 ----------
# PostgreSQL 連線字串 (必填)
DATABASE_URL="postgresql://rms_user:rms_password@localhost:5432/rms_db?schema=public"

# ---------- NextAuth 認證 ----------
# 系統對外 URL (必填，部署時改為實際網址)
NEXTAUTH_URL="http://localhost:3000"

# JWT 簽章密鑰 (必填，請用以下指令產生: openssl rand -base64 32)
NEXTAUTH_SECRET="your-secret-key-here"

# ---------- 管理員帳號 (Seed 用) ----------
# 執行 npx prisma db seed 時使用
# ADMIN_USERNAME: 管理員帳號，預設 admin (選填)
# ADMIN_PASSWORD: 管理員密碼 (必填，至少 12 字元，需含大小寫字母與數字)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---------- Docker 部署 (選填) ----------
# 使用 Docker Compose 時的 PostgreSQL root 密碼
POSTGRES_PASSWORD="rms_secure_password"

# ---------- 執行環境 (選填) ----------
# development | production
NODE_ENV="development"
